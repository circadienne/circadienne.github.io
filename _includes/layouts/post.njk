---
layout: layouts/default.njk
---

<header>
    <hgroup>
        <h1 id="title">{{ title }}</h1>
        {% if subtitle %}
            <p class="subtitle">{{ subtitle }}</p>
        {% endif %}
        {% if original %}
            <p class="original">Translated from: <a href="{{ original.link }}"><cite>{{ original.title }}</cite> ({{ original.author }})</a></p>
        {% endif %}
    </hgroup> {#

    #}{% if date or tags %}
        <aside class="data">
            {% if parent %}
                <nav>Filed under: <a href="{{ parent.url }}">{{ parent.title }}</a></nav>
            {% endif %}
            {% if date %}
                {{ date | date }}
            {% endif %}
            {% if tags and tags | filterDisplayedTags | length %}
                <span class="tag-line">Tagged as: {{ tags | filterDisplayedTags | tagDisplay }}</span>
            {% endif %}
        </aside>
    {% endif %}
</header>

{{ content }}
